# URLs da API por módulo — ajuste para o seu ambiente.
# Todas as variáveis com prefixo VITE_ ficam visíveis no bundle final.
# NUNCA coloque secrets aqui (chaves privadas, senhas de banco, etc.).

VITE_AUTH_API_URL=http://localhost:5065/liderum/api/login
VITE_USERS_API_URL=http://localhost:5065/liderum/api/user
VITE_WORKS_API_URL=http://localhost:5003/api/v1
VITE_RBAC_API_URL=http://localhost:5065/liderum/api/rbac

# Para ativar dados mockados no módulo de obras (default: false)
# VITE_USE_MOCK=true
