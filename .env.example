# Arquivo de referência — copie para .env.dsv ou .env.prd e ajuste os valores.
# Todas as variáveis VITE_ são expostas no bundle final (não use secrets aqui).

# Ambiente: dsv | prd
VITE_APP_ENV=dsv

VITE_AUTH_API_URL=http://localhost:5065/liderum/api/login
VITE_USERS_API_URL=http://localhost:5065/liderum/api/user
VITE_WORKS_API_URL=https://localhost:7141/api/v1
VITE_RBAC_API_URL=http://localhost:5065/liderum/api/rbac

# Para ativar dados mockados (default: false)
# VITE_USE_MOCK=true
