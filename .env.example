# URLs da API por módulo — ajuste para o seu ambiente.
# Todas as variáveis com prefixo VITE_ ficam visíveis no bundle final.
# NUNCA coloque secrets aqui (chaves privadas, senhas de banco, etc.).

VITE_AUTH_API_URL=http://localhost:5001/liderum/api/login
VITE_USERS_API_URL=http://localhost:5001/liderum/api/user
VITE_MANAGEMENT_API_URL=https://localhost:7036
VITE_RBAC_API_URL=http://localhost:5001/liderum/api/rbac
